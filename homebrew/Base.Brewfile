cask "arc"
cask "dropbox"
cask "figma"
cask "firefox-developer-edition"
cask "fliqlo"
cask "google-chrome"
cask "google-chrome-canary"
cask "hand-mirror"
cask "imageoptim"
cask "insomnia"
cask "iterm2"
cask "itsycal"
cask "jordanbaird-ice"
cask "logi-options-plus"
cask "notion"
cask "nova"
cask "private-internet-access"
cask "quitter"
cask "raindropio"
cask "sublime-text"
cask "tableplus"
cask "thingsmacsandboxhelper"
cask "tower"
cask "transmit"
cask "visual-studio-code"
cask "vlc"

